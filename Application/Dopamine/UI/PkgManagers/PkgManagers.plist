<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<array>
	<!--
	CustomDopamine: Zebra entry removed (redundant second package manager).
	Sileo entry kept as a bridge for now — it's the only thing that gives you
	a working install/remove UI until the merged custom GUI's package-manager
	screen (see /areas/dopamine-custom-jailbreak notes) replaces it outright.
	When that screen exists, delete this whole array and stop bundling
	sileo.deb; your GUI drives the same JBROOT_PATH(/usr/bin/dpkg) directly,
	as DOBootstrapper -installPackage: already does for the bundled .debs.
	-->
	<dict>
		<key>Display Name</key>
		<string>Sileo</string>
		<key>Key</key>
		<string>org.coolstar.SileoStore</string>
		<key>Icon</key>
		<string>Sileo</string>
		<key>Package</key>
		<string>sileo.deb</string>
	</dict>
</array>
</plist>
